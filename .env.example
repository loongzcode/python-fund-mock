# 本地运行默认使用 SQLite。部署到 MySQL 时改成 mysql+pymysql 地址。
FUND_MOCK_DATABASE_URL=sqlite:///./data/fund_mock.db

# 没有传 X-Mock-Scenario 请求头时采用的默认场景。
FUND_MOCK_DEFAULT_SCENARIO=SUCCESS

# DELAY_SUCCESS 场景等待多少毫秒后自动转成成功。
FUND_MOCK_DELAYED_SUCCESS_MILLIS=2000

# 数据库任务扫描间隔与回调最大尝试次数。
FUND_MOCK_TASK_SCAN_INTERVAL_MILLIS=500
FUND_MOCK_CALLBACK_MAX_RETRIES=5

# 公司系统提供的三个异步通知地址；留空表示只更新状态、不发送回调。
FUND_MOCK_CREDIT_CALLBACK_URL=
FUND_MOCK_LOAN_CALLBACK_URL=
FUND_MOCK_REPAYMENT_CALLBACK_URL=

# 本地开发可自动建表；生产环境建议设为 false 并执行 alembic upgrade head。
FUND_MOCK_AUTO_CREATE_TABLES=true
FUND_MOCK_START_TASK_WORKER=true

